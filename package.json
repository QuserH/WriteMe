{
  "name": "writeme",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:editor": "playwright test",
    "preview": "vite preview",
    "native:dev": "dotnet run --project native/WriteMe.Desktop/WriteMe.Desktop.csproj",
    "native:build": "dotnet build native/WriteMe.slnx -c Release --nologo",
    "native:test": "dotnet test native/WriteMe.Tests/WriteMe.Tests.csproj -c Release --nologo",
    "native:release": "powershell -NoProfile -File scripts/Publish-Native.ps1",
    "native:app": "powershell -NoProfile -File scripts/Start-Native.ps1",
    "tauri": "tauri",
    "app": "powershell -NoProfile -Command \"Start-Process '.\\src-tauri\\target\\release\\writeme.exe'\"",
    "release": "set PATH=%USERPROFILE%\\.cargo\\bin;%PATH% && \"%USERPROFILE%\\.cargo\\bin\\cargo.exe\" clean -p writeme --manifest-path src-tauri/Cargo.toml && tauri build --no-bundle && powershell -NoProfile -Command \"Copy-Item '.\\src-tauri\\target\\release\\writeme.exe' '.\\WriteME.exe' -Force\"",
    "verify-agent-note-tree": "tsx .agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-tree.ts",
    "verify-agent-note-format": "tsx .agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-format.ts",
    "verify-notes": "npm run verify-agent-note-tree && npm run verify-agent-note-format",
    "archive-note": "tsx .agents/skills/write-notes-like-deepseek/scripts/archive-agent-note.ts",
    "init-board": "tsx .agents/skills/write-notes-like-deepseek/scripts/build-board.ts --init board.html 'WriteME 决策看板'"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
